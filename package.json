{
  "name": "asoju",
  "private": true,
  "version": "0.1.0",
  "description": "ASOJU — Diaspora Support & Trusted Execution Platform (monorepo)",
  "workspaces": [
    "backend",
    "frontend",
    "fieldforce"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:fieldforce": "npm run dev --workspace=fieldforce",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:fieldforce": "npm run build --workspace=fieldforce",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "test:backend": "npm run test --workspace=backend"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "prisma@5.22.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "sharp@0.35.3": true,
    "sharp@0.34.5": true,
    "prisma@6.19.3": true,
    "@parcel/watcher@2.6.0": true,
    "es5-ext@0.10.64": true,
    "@swc/core@1.15.47": true,
    "unrs-resolver@1.12.2": true
  }
}
