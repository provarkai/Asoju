# Local development config. This is the ONLY file meant to ever be used
# as-is — every value below is a safe, non-secret default (or empty, for
# dry-run mode). Staging and production each need their own config, never
# copied from this one or from each other: see .env.staging.example and
# .env.production.example. NODE_ENV=production also fails to boot on a
# handful of these exact placeholder values on purpose — see
# backend/src/config/validate-production-env.ts.

# ---- Environment identity (optional — labels /health responses and log
# lines; NODE_ENV is what actually gates behavior, this is just for
# telling staging and production apart at a glance) ----
APP_ENV="development"

# ---- Database ----
DATABASE_URL="postgresql://asoju:asoju@localhost:5432/asoju?schema=public"

# ---- Auth (self-rolled JWT, per Section 11.2 — swap for managed provider later) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Optional — signs the short-lived MFA-pending token issued between password
# check and TOTP check (AuthService.login). Falls back to a value derived
# from JWT_ACCESS_SECRET if unset; set explicitly in production so an
# mfa-pending token can never be confused with a real access token even if
# JWT_ACCESS_SECRET is ever rotated independently.
JWT_MFA_PENDING_SECRET=""
# Security hardening — auth-endpoint brute-force throttle (login, MFA
# verify, forgot/reset-password). Defaults to 5 requests/60s if unset;
# raise only for local load-testing or the e2e suite.
AUTH_THROTTLE_LIMIT=""
AUTH_THROTTLE_TTL_MS=""

# ---- AI (Section 7 — AI Diaspora Concierge) ----
ANTHROPIC_API_KEY=""
AI_CONCIERGE_MODEL="claude-sonnet-5"

# ---- Backend server ----
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
# Base URL the backend builds links into (password reset emails) with —
# distinct from CORS_ORIGIN, which is a security allow-list that can hold
# more than one origin; this is the one canonical link target.
FRONTEND_URL="http://localhost:3000"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- Payments (Paystack — Non-Negotiable #4: only a verified webhook may
# mark a payment PAID). Leave PAYSTACK_SECRET_KEY unset to run
# initialize-transaction in dry-run/log-only mode (see PaystackService) —
# nothing is charged, nothing breaks. The webhook fails closed (rejects
# everything) without a key configured, same pattern as the AI Concierge.
PAYSTACK_SECRET_KEY=""

# ---- Object storage (Section 11.2: "buy, don't build" cloud storage —
# any S3-compatible provider works: AWS S3, Cloudflare R2, DigitalOcean
# Spaces, or MinIO for local dev). Leave S3_BUCKET unset to run evidence/
# document uploads in dry-run mode — a fake upload URL is issued and
# accepted, nothing is actually stored, same pattern as Paystack/WhatsApp.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional — only for a non-AWS S3-compatible endpoint (R2/Spaces/MinIO).
S3_ENDPOINT=""
# Optional — "true" for MinIO/some providers that need path-style
# addressing (https://host/bucket/key) instead of virtual-hosted-style.
S3_FORCE_PATH_STYLE=""

# ---- Email (Resend — resend.dev) ----
# Leave unset to run password-reset emails (and any future transactional
# email) in dry-run/log-only mode (see EmailService) — nothing is sent,
# the devToken escape hatch (outside NODE_ENV=production) still works.
RESEND_API_KEY=""
# Optional — defaults to Resend's shared onboarding@resend.dev sender,
# which only delivers to the Resend account's OWN verified email until a
# real sending domain is verified in Resend's dashboard. Set this to
# "ASOJU <no-reply@yourdomain.example>" once that's done.
RESEND_FROM_EMAIL=""

# ---- WhatsApp (Zavu — docs.zavu.dev) ----
# Shared secret the inbound webhook must present — same stand-in pattern as
# PAYMENT_WEBHOOK_SECRET, until real Zavu signature verification replaces
# it (see WhatsappWebhookGuard — inbound is still a stand-in on purpose).
WHATSAPP_WEBHOOK_SECRET="change-me-whatsapp-webhook-secret"
# Leave unset to run WhatsApp sends in dry-run/log-only mode (see
# WhatsappSenderService) — nothing is sent, nothing breaks. A zv_test_...
# key (Zavu's sandbox key format) works here too but never actually
# delivers a message — Zavu documents test keys as simulate-only. Get a
# real key from the Zavu dashboard: Settings -> API Keys.
ZAVU_API_KEY=""
# Optional — routes sends through a specific sender profile (Zavu
# dashboard's sender id, shaped like "snd_..."); omitted uses the
# project's default sender.
ZAVU_SENDER_ID=""
