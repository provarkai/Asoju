# ---- Database ----
DATABASE_URL="postgresql://asoju:asoju@localhost:5432/asoju?schema=public"

# ---- Auth (self-rolled JWT, per Section 11.2 — swap for managed provider later) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- AI (Section 7 — AI Diaspora Concierge) ----
ANTHROPIC_API_KEY=""
AI_CONCIERGE_MODEL="claude-sonnet-5"

# ---- Backend server ----
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- Third-party (wired in later phases per Section 11.2 — not required for MVP slice 1) ----
WHATSAPP_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_SECRET_KEY=""
