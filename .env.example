# ---- Database ----
DATABASE_URL="postgresql://asoju:asoju@localhost:5432/asoju?schema=public"

# ---- Auth (self-rolled JWT, per Section 11.2 — swap for managed provider later) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- AI (Section 7 — AI Diaspora Concierge) ----
ANTHROPIC_API_KEY=""
AI_CONCIERGE_MODEL="claude-sonnet-5"

# ---- Backend server ----
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- Third-party (wired in later phases per Section 11.2 — not required for MVP slice 1) ----
PAYMENT_PROVIDER_SECRET_KEY=""

# Shared secret the payment provider's webhook must present until a real
# provider integration (Paystack/Flutterwave) replaces this stand-in
# (Non-Negotiable #4 — only a verified webhook may mark a payment PAID).
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# ---- WhatsApp (Section 12 P1 — needs a real provider to verify live) ----
# Shared secret the inbound webhook must present — same stand-in pattern as
# PAYMENT_WEBHOOK_SECRET, until real Twilio/360dialog signature
# verification replaces it (see WhatsappWebhookGuard).
WHATSAPP_WEBHOOK_SECRET="change-me-whatsapp-webhook-secret"
# Leave the three below unset to run WhatsApp sends in dry-run/log-only
# mode (see WhatsappSenderService) — nothing is sent, nothing breaks.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
