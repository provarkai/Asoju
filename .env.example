# ---- Database ----
DATABASE_URL="postgresql://asoju:asoju@localhost:5432/asoju?schema=public"

# ---- Auth (self-rolled JWT, per Section 11.2 — swap for managed provider later) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- AI (Section 7 — AI Diaspora Concierge) ----
ANTHROPIC_API_KEY=""
AI_CONCIERGE_MODEL="claude-sonnet-5"

# ---- Backend server ----
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- Payments (Paystack — Non-Negotiable #4: only a verified webhook may
# mark a payment PAID). Leave PAYSTACK_SECRET_KEY unset to run
# initialize-transaction in dry-run/log-only mode (see PaystackService) —
# nothing is charged, nothing breaks. The webhook fails closed (rejects
# everything) without a key configured, same pattern as the AI Concierge.
PAYSTACK_SECRET_KEY=""

# ---- WhatsApp (Section 12 P1 — needs a real provider to verify live) ----
# Shared secret the inbound webhook must present — same stand-in pattern as
# PAYMENT_WEBHOOK_SECRET, until real Twilio/360dialog signature
# verification replaces it (see WhatsappWebhookGuard).
WHATSAPP_WEBHOOK_SECRET="change-me-whatsapp-webhook-secret"
# Leave the three below unset to run WhatsApp sends in dry-run/log-only
# mode (see WhatsappSenderService) — nothing is sent, nothing breaks.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
