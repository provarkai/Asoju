# FieldForce app (Next.js) — local dev defaults. Copy to .env and fill in.

# SQLite by default for local dev; point at Postgres in staging/prod.
DATABASE_URL="file:./db/custom.db"

NODE_ENV="development"

# Session/auth signing secret — set a real random value outside local dev.
JWT_SECRET="change-me-in-production"

# Paystack (payouts to field agents)
PAYSTACK_SECRET_KEY=""

# WhatsApp Business API (agent notifications)
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
