# Staging config template. Staging is a real deployed environment, not a
# bigger local dev — it exists to catch what local dev and the automated
# test suites can't (real provider webhooks, real DNS/TLS, real timing).
# That only works if it's actually separated from both dev and production:
#
#   - Its own Postgres database — NEVER pointed at the production DB, and
#     never at the same instance dev/CI use.
#   - Its own domain (e.g. staging.yourdomain.com), issued its own TLS.
#   - Its own copies of every external account below where the provider
#     supports one (Paystack has a test/live key pair for exactly this;
#     Twilio/WhatsApp and S3 don't distinguish, so staging gets its own
#     separate bucket/sender at minimum so a staging run can never touch a
#     real customer's data).
#   - Its own secrets, generated fresh — never copied from .env.example or
#     from production. Generate with: openssl rand -hex 32
#
# NODE_ENV is "production" here on purpose (see .env.example's note) — it's
# what turns on the framework-level production behavior and the startup
# validation in backend/src/config/validate-production-env.ts. What makes
# this staging and not production is which values go in below, not this
# line. APP_ENV is what actually distinguishes them for humans reading logs
# or /health.

APP_ENV="staging"
NODE_ENV="production"

# ---- Database (staging's own instance — never production's) ----
DATABASE_URL=""

# ---- Auth — generate fresh, do not reuse production's or dev's ----
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_MFA_PENDING_SECRET=""
AUTH_THROTTLE_LIMIT=""
AUTH_THROTTLE_TTL_MS=""

USD_TO_NGN_RATE=""
PAYMENT_EXPIRY_HOURS=""
QUOTE_VALIDITY_HOURS=""
SLA_HOURS_STANDARD=""
SLA_HOURS_PRIORITY=""
SLA_HOURS_URGENT=""

# ---- AI ----
ANTHROPIC_API_KEY=""
AI_CONCIERGE_MODEL="claude-sonnet-5"

# ---- Backend server ----
PORT=3001
CORS_ORIGIN="https://staging.yourdomain.example"
FRONTEND_URL="https://staging.yourdomain.example"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="https://api-staging.yourdomain.example"

# ---- Payments — Paystack's TEST key, never the live one ----
PAYSTACK_SECRET_KEY=""

# ---- Object storage — a bucket of its own, not production's ----
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=""

# ---- Email (Resend) — a real key is fine here; use its own verified
# sending domain/subdomain, not production's ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ---- WhatsApp (Zavu) — a zv_test_... sandbox key, never a live one ----
WHATSAPP_WEBHOOK_SECRET=""
ZAVU_API_KEY=""
ZAVU_SENDER_ID=""
