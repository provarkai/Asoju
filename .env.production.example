# Production config template. Every rule from .env.staging.example applies
# here too, with one addition: nothing in this file may ever be equal to
# anything in .env.example, .env.staging.example, or another production
# deploy's values — a shared secret between environments means a breach of
# the weaker one is a breach of this one too.
#
#   - Its own Postgres database, with automated backups AND a tested
#     restore procedure (still open per the independent readiness review —
#     this file doesn't solve that, only flags it).
#   - Its own domain, its own TLS.
#   - Live Paystack key, live WhatsApp/Twilio sender, production S3 bucket.
#   - Fresh secrets: openssl rand -hex 32. Store them in a real secrets
#     manager (your host's built-in secrets, Doppler, Vault, AWS/GCP
#     Secrets Manager) — not as a checked-in file, not in shell history.
#
# backend/src/config/validate-production-env.ts refuses to boot this
# process if JWT_ACCESS_SECRET/JWT_REFRESH_SECRET/WHATSAPP_WEBHOOK_SECRET
# are unset or still equal to .env.example's dev defaults, if DATABASE_URL
# is unset, or if CORS_ORIGIN is unset (which would otherwise silently fall
# back to allowing every origin). That check exists so a config this
# incomplete fails loudly at startup instead of running insecurely.

APP_ENV="production"
NODE_ENV="production"

# ---- Database (production's own instance, with backups configured) ----
DATABASE_URL=""

# ---- Auth — fresh secrets, in a secrets manager, not this file ----
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_MFA_PENDING_SECRET=""
AUTH_THROTTLE_LIMIT=""
AUTH_THROTTLE_TTL_MS=""

USD_TO_NGN_RATE=""

# ---- AI ----
ANTHROPIC_API_KEY=""
AI_CONCIERGE_MODEL="claude-sonnet-5"

# ---- Backend server ----
PORT=3001
CORS_ORIGIN="https://yourdomain.example"
FRONTEND_URL="https://yourdomain.example"

# ---- Frontend ----
NEXT_PUBLIC_API_URL="https://api.yourdomain.example"

# ---- Payments — Paystack's LIVE key ----
PAYSTACK_SECRET_KEY=""

# ---- Object storage — production's own bucket ----
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=""

# ---- Email (Resend) — production's own verified sending domain ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ---- WhatsApp (Zavu) — a zv_live_... key, never the test one ----
WHATSAPP_WEBHOOK_SECRET=""
ZAVU_API_KEY=""
ZAVU_SENDER_ID=""
