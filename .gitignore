# Dependencies
node_modules/

# Build output
# NOTE: no blanket "build/"/"out/" here — this monorepo's real build
# output is backend/dist (NestJS) and frontend/.next (Next.js), both
# covered below. A blanket "build/" also silently swallowed the locked
# ASOJU Build service route (frontend/src/app/build/) added in Sprint 1.
dist/
.next/

# Env
.env
.env.local
.env.*.local
.env.staging
.env.production

# Logs
npm-debug.log*
*.log

# Prisma
backend/prisma/migrations/dev.db

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Testing
coverage/
*.tsbuildinfo
